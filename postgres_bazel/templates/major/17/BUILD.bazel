"""PostgreSQL 18.4 - libpq, libcommon and libpgport built with rules_cc_autoconf.

This file replaces the hand-crafted `pg_config.h` from earlier postgres BCR
modules with a real autoconf-style probe driven by `rules_cc_autoconf`.

Public configure-style flags are exposed as `bool_flag`/`string_flag`, mirroring
the `--with-*` / `--enable-*` switches of upstream `./configure`. See the top of
the file for the full list.
"""

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@postgres_config//:dist.bzl", "directory_output", "pg_wrapper")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc_autoconf//autoconf:autoconf.bzl", "autoconf")
load("@rules_cc_autoconf//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("@rules_cc_autoconf//autoconf:checks.bzl", "checks", "macros", "utils")
load("@rules_cc_autoconf//autoconf:package_info.bzl", "package_info")
load("@postgres_config//private:curl_ssl_transition.bzl", "pg_ssl_bundle")

# ---------------------------------------------------------------------------
# Version metadata.
# ---------------------------------------------------------------------------
PG_MAJORVERSION_NUM = "{major}"

PG_MINORVERSION_NUM = "{minor}"

PG_VERSION = "{version}"

PG_VERSION_NUM = "{version_num}"

# ---------------------------------------------------------------------------
# Build settings live in @postgres_config so a project depending on several
# PostgreSQL versions configures them once, not once per version. See that
# repository's BUILD file for the full list.
# ---------------------------------------------------------------------------

# Compiler-aware config_setting_groups so the autoconf rule below can emit
# different defines on MSVC than on GCC/Clang. MSVC doesn't grok
# `__int128`, GCC's `gnu_printf` format attribute, or x86_64 inline-asm
# popcntq / SSE4.2 CRC32C; it does have `__cpuid` / `__cpuidex` intrinsics
# in their place. The `clang-cl` variant of clang is also MSVC-syntax, so
# it falls into the same bucket.
selects.config_setting_group(
    name = "_msvc_like",
    match_any = [
        "@rules_cc//cc/compiler:msvc-cl",
        "@rules_cc//cc/compiler:clang-cl",
    ],
)

selects.config_setting_group(
    name = "_gcc_like",
    match_any = [
        "@rules_cc//cc/compiler:clang",
        "@rules_cc//cc/compiler:emscripten",
        "@rules_cc//cc/compiler:gcc",
        "@rules_cc//cc/compiler:mingw-gcc",
    ],
)

selects.config_setting_group(
    name = "_x86_64_msvc_like",
    match_all = [
        "@platforms//cpu:x86_64",
        ":_msvc_like",
    ],
)

selects.config_setting_group(
    name = "_x86_64_gcc_like",
    match_all = [
        "@platforms//cpu:x86_64",
        ":_gcc_like",
    ],
)

# OAuth flow requires libcurl AND either `<sys/epoll.h>` (Linux) or
# `<sys/event.h>` (macOS / BSD). Windows has neither, so upstream's
# meson.build leaves `oauth_flow_supported = false` there: it doesn't
# compile `libpq-oauth/oauth-curl.c` and doesn't set `USE_LIBCURL`. The
# source file even has `#error libpq-oauth is not supported on this
# platform` to enforce the rule. We mirror that with this group.
selects.config_setting_group(
    name = "_oauth_supported_os",
    match_any = [
        "@platforms//os:freebsd",
        "@platforms//os:linux",
        "@platforms//os:macos",
        "@platforms//os:netbsd",
        "@platforms//os:openbsd",
    ],
)

selects.config_setting_group(
    name = "_libcurl_on_oauth_supported",
    match_all = [
        "@postgres_config//:libcurl_on",
        ":_oauth_supported_os",
    ],
)

# ---------------------------------------------------------------------------
# Hand-written / generated headers that don't fit autoconf's probe model.
# ---------------------------------------------------------------------------

write_file(
    name = "pg_config_ext_h_lp64",
    out = "src/include/pg_config_ext.h.lp64",
    content = [
        "/* src/include/pg_config_ext.h.  Generated from Bazel.  */",
        "",
        "/* Define to the name of a signed 64-bit integer type. */",
        "#define PG_INT64_TYPE long int",
    ],
    newline = "unix",
)

write_file(
    name = "pg_config_ext_h_llp64",
    out = "src/include/pg_config_ext.h.llp64",
    content = [
        "/* src/include/pg_config_ext.h.  Generated from Bazel.  */",
        "",
        "/* Define to the name of a signed 64-bit integer type. */",
        "#define PG_INT64_TYPE long long int",
    ],
    newline = "unix",
)

copy_file(
    name = "pg_config_ext_h",
    src = select({
        "@platforms//os:windows": ":pg_config_ext_h_llp64",
        "//conditions:default": ":pg_config_ext_h_lp64",
    }),
    out = "src/include/pg_config_ext.h",
)

write_file(
    name = "pg_config_paths_h",
    out = "src/include/pg_config_paths.h",
    content = [
        "/* src/include/pg_config_paths.h.  Generated from Bazel.  */",
        "#define PGBINDIR \"/usr/local/pgsql/bin\"",
        "#define PGSHAREDIR \"/usr/local/pgsql/share\"",
        "#define SYSCONFDIR \"/usr/local/pgsql/etc\"",
        "#define INCLUDEDIR \"/usr/local/pgsql/include\"",
        "#define PKGINCLUDEDIR \"/usr/local/pgsql/include\"",
        "#define INCLUDEDIRSERVER \"/usr/local/pgsql/include/server\"",
        "#define LIBDIR \"/usr/local/pgsql/lib\"",
        "#define PKGLIBDIR \"/usr/local/pgsql/lib\"",
        "#define LOCALEDIR \"/usr/local/pgsql/share/locale\"",
        "#define DOCDIR \"/usr/local/pgsql/share/doc/\"",
        "#define HTMLDIR \"/usr/local/pgsql/share/doc/\"",
        "#define MANDIR \"/usr/local/pgsql/share/man\"",
    ],
    newline = "unix",
)

copy_file(
    name = "pg_config_os_h",
    src = select({
        "@platforms//os:freebsd": "src/include/port/freebsd.h",
        "@platforms//os:macos": "src/include/port/darwin.h",
        "@platforms//os:netbsd": "src/include/port/netbsd.h",
        "@platforms//os:openbsd": "src/include/port/openbsd.h",
        "@platforms//os:windows": "src/include/port/win32.h",
        "//conditions:default": "src/include/port/linux.h",
    }),
    out = "src/include/pg_config_os.h",
)

