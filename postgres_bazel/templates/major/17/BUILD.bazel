    "src/port/pgstrcasecmp.c",
    "src/port/pgstrsignal.c",
    "src/port/pqsignal.c",
    "src/port/qsort.c",
    "src/port/qsort_arg.c",
    "src/port/quotes.c",
    "src/port/snprintf.c",
    "src/port/strerror.c",
    "src/port/tar.c",
    "src/port/user.c",
]

# Replacement files compiled when the OS libc lacks the function. Upstream's
# `meson.build` enables these via `replace_funcs_neg`, gated on the HAVE_*
# autoconf result. We can't easily select on probe-results from srcs, so we
# pick the canonical set for each platform.
# timingsafe_bcmp.c was backported in 17.10; earlier releases don't ship it.
_TIMINGSAFE_BCMP_SRCS = ["src/port/timingsafe_bcmp.c"] if int(PG_MINORVERSION_NUM) >= 10 else []

_LIBPORT_LINUX_SRCS = _TIMINGSAFE_BCMP_SRCS + [
    # glibc has explicit_bzero (>=2.25), getopt(_long), inet_aton, mkdtemp,
    # strnlen, strsep and pthread_barrier_wait. Everything else needs a
    # postgres-supplied replacement.
    "src/port/explicit_bzero.c",
    "src/port/getpeereid.c",
    "src/port/strlcat.c",
    "src/port/strlcpy.c",
]

_LIBPORT_MACOS_SRCS = [
    # macOS provides strlcat/strlcpy/timingsafe_bcmp natively but lacks
    # explicit_bzero and pthread_barrier_wait.
    "src/port/explicit_bzero.c",
    "src/port/pthread_barrier_wait.c",
]

_LIBPORT_WINDOWS_SRCS = _TIMINGSAFE_BCMP_SRCS + [
    "src/port/dirent.c",
    "src/port/dirmod.c",
    # MSVC's libc lacks these; postgres ships replacements that meson's
    # `replace_funcs_neg` would add when the probe fails. We can't drive
    # cc_library srcs from probe results, so we list them statically.
    # `strnlen` is intentionally omitted — MSVC's CRT has it since at
    # least 2010.
    "src/port/explicit_bzero.c",
    "src/port/getopt.c",
    "src/port/getopt_long.c",
    "src/port/getpeereid.c",
    "src/port/inet_aton.c",
    "src/port/kill.c",
    "src/port/mkdtemp.c",
    "src/port/open.c",
    "src/port/strlcat.c",
    "src/port/strlcpy.c",
    "src/port/win32common.c",
    "src/port/win32dlopen.c",
    "src/port/win32env.c",
    "src/port/win32error.c",
    "src/port/win32fdatasync.c",
    "src/port/win32fseek.c",
    # Postgres's own thread-safe replacement for Winsock `gai_strerror`;
    # `port/win32/sys/socket.h` `#undef`s the Windows macro and declares
    # the postgres extern.
    "src/port/win32gai_strerror.c",
    "src/port/win32getrusage.c",
    "src/port/win32gettimeofday.c",
    "src/port/win32link.c",
    "src/port/win32ntdll.c",
    "src/port/win32pread.c",
    "src/port/win32pwrite.c",
    "src/port/win32security.c",
    "src/port/win32setlocale.c",
    "src/port/win32stat.c",
]

cc_library(
    name = "pgport",
    srcs = _LIBPORT_BASE_SRCS + select({
        "@platforms//os:linux": _LIBPORT_LINUX_SRCS,
        "@platforms//os:macos": _LIBPORT_MACOS_SRCS,
        "@platforms//os:windows": _LIBPORT_WINDOWS_SRCS,
        "//conditions:default": _LIBPORT_LINUX_SRCS,
    }),
    # Upstream meson explicitly adds these as raw `cppflags`
    # (`/DWIN32 /DWINDOWS /D__WIN32__ /D__WINDOWS__
    # /D_CRT_SECURE_NO_DEPRECATE /D_CRT_NONSTDC_NO_DEPRECATE`). Going
    # through `copts` rather than `local_defines`/`defines` matches
    # upstream's meson.build exactly and bypasses flag-ordering quirks in
    # Bazel's MSVC toolchain that have caused `#ifndef WIN32` in
    # `chklocale.c` to evaluate true even when we set WIN32 via
    # `local_defines`/`defines`. Symbol names match upstream meson
    # exactly (`WINDOWS`, not `_WINDOWS`).
    copts = select({
        "@platforms//os:windows": [
            "/DWIN32",
            "/DWINDOWS",
            "/D__WIN32__",
            "/D__WINDOWS__",
            "/D_CRT_SECURE_NO_DEPRECATE",
            "/D_CRT_NONSTDC_NO_DEPRECATE",
        ],
        "//conditions:default": [],
    }),
    # Also on `defines` so they propagate to consumer-compile commands
    # (libpq, libpgcommon, the tests) without each having to repeat the
    # copts dance.
    defines = select({
        "@platforms//os:windows": [
            "WIN32",
            "WINDOWS",
            "__WIN32__",
            "__WINDOWS__",
        ],
        "//conditions:default": [],
    }),
    local_defines = [
        "FRONTEND",
    ] + select({
        "@platforms//os:linux": ["_GNU_SOURCE"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":include",
        # pg_strong_random.c calls into OpenSSL's RAND_bytes when USE_OPENSSL
        # is defined; pull the SSL backend in even though pgport otherwise has
        # no link-time requirement on it.
        ":ssl_backend",
    ],
)

