    deps = [
        ":include",
        ":pgport",
        ":ssl_backend",
    ],
)

# ---------------------------------------------------------------------------
# SSL backend.
# ---------------------------------------------------------------------------

# All of libpq's SSL link inputs in one place: openssl or boringssl plus,
# when `:with_libcurl=True`, `@curl//:curl`. Wrapping this one bundle with
# `pg_ssl_bundle` (below) pins `@curl//:ssl_lib` to whatever `//:with_ssl`
# is set to and routes every SSL-touching dep of libpq through a single
# configuration of `@openssl` / `@boringssl`. See
# `@postgres_config//private:curl_ssl_transition.bzl` for the why.
cc_library(
    name = "_ssl_backend_raw",
    defines = select({
        "@postgres_config//:ssl_boringssl": ["BAZEL_PQ_USE_BORINGSSL=1"],
        "//conditions:default": [],
    }),
    deps = select({
        "@postgres_config//:ssl_boringssl": [
            "@boringssl//:crypto",
            "@boringssl//:ssl",
        ],
        "@postgres_config//:ssl_none": [],
        "@postgres_config//:ssl_openssl": [
            "@openssl//:crypto",
            "@openssl//:ssl",
        ],
    }) + select({
        # Curl is only linked where the OAuth flow is supported (libcurl +
        # epoll/kqueue). On Windows that's never true, so don't pull
        # `@curl` into the SSL bundle there.
        ":_libcurl_on_oauth_supported": ["@curl"],
        "//conditions:default": [],
    }),
)

pg_ssl_bundle(
    name = "ssl_backend",
    target = ":_ssl_backend_raw",
)

