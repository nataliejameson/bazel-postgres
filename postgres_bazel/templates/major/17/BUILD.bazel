    ],
)

# Assembles bin/ and share/ as siblings. This layout is not cosmetic:
# get_share_path() derives PGSHAREDIR by walking up from the running
# executable, and only does so when the binary's directory is named "bin".
# Anywhere else it falls back to the compiled-in /usr/local/pgsql/share.
directory_output(
    name = "pg_dist",
    cmd = """
set -e
mkdir -p {out}/bin {out}/share/timezonesets {out}/share/extension {out}/lib
cp $(execpath :initdb) $(execpath :pg_ctl) $(execpath :postgres) $(execpath :psql) {out}/bin/
for f in SHARE_FILES; do cp "$f" {out}/share/; done
for f in $(execpaths :tznames); do cp "$f" {out}/share/timezonesets/; done
cp -R $(execpath :tzdata) {out}/share/timezone
cp -R $(execpath :pg_lib)/. {out}/lib/
cp $(execpath src/pl/plpgsql/src/plpgsql.control) \
   $(execpath src/pl/plpgsql/src/plpgsql--1.0.sql) {out}/share/extension/
""".replace("SHARE_FILES", " ".join(["$(execpath %s)" % f for f in _SHARE_FILES])),
    dirname = "dist",
    srcs = _SHARE_FILES + [
        ":initdb",
        ":pg_ctl",
        ":postgres",
        ":pg_lib",
        ":psql",
        "src/pl/plpgsql/src/plpgsql--1.0.sql",
        "src/pl/plpgsql/src/plpgsql.control",
        ":tzdata",
        ":tznames",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "tznames",
    srcs = glob(["src/timezone/tznames/*"]),
)

# Runnable wrappers. Each stages the dist tree as runfiles and execs the
# matching binary out of its bin/, so callers get `bazel run
# @postgres_18_4//:psql_bin` or a plain `data` dep instead of having to spell
# out `$(location :pg_dist)/bin/psql` and arrange the tree themselves.
[
    pg_wrapper(
        name = binary + "_bin",
        binary = binary,
        dist = ":pg_dist",
        visibility = ["//visibility:public"],
    )
    for binary in [
        "initdb",
        "pg_ctl",
        "postgres",
        "psql",
    ]
]
