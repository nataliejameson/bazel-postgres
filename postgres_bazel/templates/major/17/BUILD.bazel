cc_library(
    name = "pgcommon",
    srcs = _LIBCOMMON_BASE + select({
        "@postgres_config//:ssl_none": _LIBCOMMON_NOSSL,
        "//conditions:default": _LIBCOMMON_SSL,
    }),
    includes = [
        "src/interfaces/libpq",
    ],
    local_defines = [
