# CRC32C. The overlay ships only the slicing-by-8 fallback, which is all
# libpq needs, but the backend calls pg_comp_crc32c through the runtime
# dispatch pointer that lives in the *_choose.c files. The autoconf probes
# above set USE_{SSE42,ARMV8}_CRC32C_WITH_RUNTIME_CHECK, so we need the
# hardware implementation, its chooser, and sb8 as the runtime fallback.
#
# The armv8 path is compiled with -march=armv8-a+crc: the intrinsics are
# guarded by a runtime check, so the flag only has to make them compile, not
# be safe to execute everywhere.
cc_library(
    name = "pgport_crc32c",
    # pg_crc32c_sb8.c is the runtime fallback and already comes from
    # _LIBPORT_BASE_SRCS; listing it again here would define its symbols twice.
    srcs = select({
        ":_x86_64_gcc_like": ["src/port/pg_crc32c_sse42_choose.c"],
        "@platforms//cpu:arm64": [
            "src/port/pg_crc32c_armv8.c",
            "src/port/pg_crc32c_armv8_choose.c",
        ],
        "//conditions:default": [],
    }),
    copts = select({
        "@platforms//cpu:arm64": ["-march=armv8-a+crc"],
        "//conditions:default": [],
    }),
    # pg_comp_crc32c is a function pointer reached through a macro, so the
    # linker sees no direct reference and drops the archive member.
    alwayslink = True,
    local_defines = ["FRONTEND"],
    deps = [":include"] + select({
        ":_x86_64_gcc_like": [":_pgport_crc32c_sse42"],
        "//conditions:default": [],
    }),
)

# Upstream's CFLAGS_CRC: before 18 the SSE4.2 intrinsics aren't marked with a
# target attribute, so this one file needs -msse4.2. It's kept out of the
# chooser, which has to run on CPUs without SSE4.2.
cc_library(
    name = "_pgport_crc32c_sse42",
    srcs = ["src/port/pg_crc32c_sse42.c"],
    copts = ["-msse4.2"],
    alwayslink = True,
    target_compatible_with = select({
        ":_x86_64_gcc_like": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":include"],
)

cc_library(
    name = "pgport_crc32c_srv",
    # pg_crc32c_sb8.c is the runtime fallback and already comes from
    # _LIBPORT_BASE_SRCS; listing it again here would define its symbols twice.
    srcs = select({
        ":_x86_64_gcc_like": ["src/port/pg_crc32c_sse42_choose.c"],
        "@platforms//cpu:arm64": [
            "src/port/pg_crc32c_armv8.c",
            "src/port/pg_crc32c_armv8_choose.c",
        ],
        "//conditions:default": [],
    }),
    copts = select({
        "@platforms//cpu:arm64": ["-march=armv8-a+crc"],
        "//conditions:default": [],
    }),
    # pg_comp_crc32c is a function pointer reached through a macro, so the
    # linker sees no direct reference and drops the archive member.
    alwayslink = True,
    deps = [":include"] + select({
        ":_x86_64_gcc_like": [":_pgport_crc32c_sse42"],
        "//conditions:default": [],
    }),
)

