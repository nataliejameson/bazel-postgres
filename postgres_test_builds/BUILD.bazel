load("@postgres_bazel//:defs.bzl", "postgres_smoke_test")

# One of these per version: initdb a cluster, start it, query it, shut it down.
postgres_smoke_test(
    name = "postgres_18_4_smoke_test",
    dist = "@postgres_18_4//:pg_dist",
    version = "18.4",
)

alias(
    name = "postgres_18_4_psql",
    actual = "@postgres_18_4//:psql",
)

alias(
    name = "postgres_18_4_libpq",
    actual = "@postgres_18_4//:libpq",
)
